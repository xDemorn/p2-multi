MAX_PLAYERS=6
PORT=2567
COOKIE_SECURE=development
JWT_SECRET=change-me
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DB_PATH=db/data.db
UPLOAD_DIR=public/uploads

# Password recovery: backend only. Use a verified Brevo sender.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="El torneo de los magos"
# Public URL of this server, used in password reset emails.
SERVER_URL=http://localhost:2567
# Public URL of the game client. When set, the old server pages (/, /login, /profile...) redirect there.
CLIENT_URL=http://localhost:5173
# 0 for direct local access; 1 behind Render's reverse proxy.
TRUST_PROXY_HOPS=0
