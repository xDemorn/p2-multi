{
  "name": "iso-server",
  "version": "1.0.0",
  "description": "Server for the isometric game",
  "engines": {
    "node": ">=20.11"
  },
  "type": "module",
  "scripts": {
    "prestart": "node setup-env.js",
    "start": "node --env-file=.env --import ./db/create_db.js index.js",
    "predev": "node setup-env.js",
    "dev": "nodemon --exec \"node --env-file=.env --import ./db/create_db.js\" index.js",
    "predb": "node setup-env.js",
    "db": "node --env-file=.env db/create_db.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "axios": "^1.21.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "eta": "^4.6.0",
    "express": "^4.19.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "otplib": "^13.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
